{
  "name": "breakpoint-apac",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3107",
    "build": "next build",
    "start": "next start --port 3107",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "pnpm build && playwright test tests/e2e"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.39",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "braces": "file:vendor/braces"
    }
  }
}
